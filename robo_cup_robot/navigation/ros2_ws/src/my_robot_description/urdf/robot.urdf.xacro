<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="front_diff_robot">

  <!-- ======================================================= -->
  <!-- ROBOT PARAMETERS                                        -->
  <!-- ======================================================= -->
  <xacro:property name="chassis_length"       value="0.38"/>
  <xacro:property name="chassis_width"        value="0.38"/>
  <xacro:property name="chassis_height"       value="0.08"/> 
  <xacro:property name="chassis_mass"         value="5.0"/>
  <xacro:property name="base_plate_elevation" value="0.13175"/> <!-- 131.75mm above ground -->

  <!-- Hub Wheels: 13cm diameter = 6.5cm (0.065m) radius -->
  <xacro:property name="hub_radius"           value="0.065"/> 
  <xacro:property name="hub_width"            value="0.038"/>  
  
  <!-- Casters: 2.5cm (0.025m) radius -->
  <xacro:property name="caster_radius"        value="0.025"/> 
  <xacro:property name="caster_width"         value="0.020"/>  
  
  <!-- Wheelbase & Track Width -->
  <xacro:property name="wheelbase"            value="0.1985"/>   <!-- 198.5mm -->
  <xacro:property name="track_width"          value="0.26000"/>  <!-- 260mm track width -->
  
  <xacro:property name="pi"                   value="3.14159265359"/> 

  <!-- Sensors -->
  <xacro:property name="lidar_radius"         value="0.03"/> 
  <xacro:property name="lidar_height"         value="0.04"/> 

  <!-- ======================================================= -->
  <!-- MATERIALS                                               -->
  <!-- ======================================================= -->
  <material name="white"><color rgba="0.9 0.9 0.9 1.0"/></material>
  <material name="black"><color rgba="0.1 0.1 0.1 1.0"/></material>
  <material name="blue"><color rgba="0.2 0.2 0.8 1.0"/></material>
  <material name="red"><color rgba="0.8 0.1 0.1 1.0"/></material>

  <!-- ======================================================= -->
  <!-- INERTIA MACROS                                          -->
  <!-- ======================================================= -->
  <xacro:macro name="box_inertia" params="m w h d">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${(m/12) * (h*h + d*d)}" ixy="0.0" ixz="0.0" 
               iyy="${(m/12) * (w*w + d*d)}" iyz="0.0" 
               izz="${(m/12) * (w*w + h*h)}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${(m/12) * (3*r*r + h*h)}" ixy="0" ixz="0" 
               iyy="${(m/12) * (3*r*r + h*h)}" iyz="0" 
               izz="${(m/2) * (r*r)}"/>
    </inertial>
  </xacro:macro>

  <!-- ======================================================= -->
  <!-- BASE FOOTPRINT & BASE LINK                              -->
  <!-- ======================================================= -->
  <link name="base_footprint"/>

  <!-- Red axis points toward the Hub Wheels -->
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${hub_radius}" rpy="0 0 0"/>
  </joint>

  <link name="base_link"/>

  <!-- ======================================================= -->
  <!-- CHASSIS (Centered between Hub Wheels and Casters)       -->
  <!-- ======================================================= -->
  <link name="chassis">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="${chassis_mass}" w="${chassis_length}" h="${chassis_width}" d="${chassis_height}"/>
  </link>

  <joint name="chassis_joint" type="fixed">
    <parent link="base_link"/>
    <child link="chassis"/>
    <origin xyz="${-wheelbase/2} 0 ${base_plate_elevation - hub_radius + (chassis_height/2)}" rpy="0 0 0"/>
  </joint>

  <!-- ======================================================= -->
  <!-- HUB WHEELS (Located at X = 0 -> RED AXIS POINTS HERE!)  -->
  <!-- ======================================================= -->
  <xacro:macro name="drive_wheel" params="prefix y_offset">
    <link name="${prefix}_wheel">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${hub_radius}" length="${hub_width}"/>
        </geometry>
        <material name="black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${hub_radius}" length="${hub_width}"/>
        </geometry>
      </collision>
      <xacro:cylinder_inertia m="1.0" r="${hub_radius}" h="${hub_width}"/>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel"/>
      <!-- Located at X = 0 -->
      <origin xyz="0 ${y_offset} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:drive_wheel prefix="left" y_offset="${track_width/2}"/>
  <xacro:drive_wheel prefix="right" y_offset="${-track_width/2}"/>

  <!-- ======================================================= -->
  <!-- CASTER WHEELS (Located behind Hub Wheels at -wheelbase) -->
  <!-- ======================================================= -->
  <xacro:macro name="caster_wheel" params="prefix y_offset">
    <link name="${prefix}_caster">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${caster_radius}" length="${caster_width}"/>
        </geometry>
        <material name="blue"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <sphere radius="${caster_radius}"/>
        </geometry>
      </collision>
      <xacro:cylinder_inertia m="0.2" r="${caster_radius}" h="${caster_width}"/>
    </link>

    <joint name="${prefix}_caster_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${prefix}_caster"/>
      <!-- Located at -wheelbase -->
      <origin xyz="-${wheelbase} ${y_offset} -${hub_radius - caster_radius}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>

    <gazebo reference="${prefix}_caster">
      <mu1>0.0</mu1>
      <mu2>0.0</mu2>
      <material>Gazebo/Blue</material>
    </gazebo>
  </xacro:macro>

  <!-- Casters placed inside the chassis footprint -->
  <xacro:caster_wheel prefix="left" y_offset="${(chassis_width/2) - 0.05}"/>
  <xacro:caster_wheel prefix="right" y_offset="-${(chassis_width/2) - 0.05}"/>

  <!-- ======================================================= -->
  <!-- SENSORS: LIDAR (Facing the direction of Hub Wheels)     -->
  <!-- ======================================================= -->
  <link name="lidar_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
      </geometry>
      <material name="red"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertia m="0.12" r="${lidar_radius}" h="${lidar_height}"/>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="chassis"/>
    <child link="lidar_link"/>
    <!-- Positioned on top of chassis, Red axis points to Hub Wheels -->
    <origin xyz="0 0 ${chassis_height/2 + lidar_height/2}" rpy="0 0 0"/>
  </joint>

  <!-- Gazebo LiDAR Plugin -->
  <gazebo reference="lidar_link">
    <material>Gazebo/Red</material>
    <sensor type="ray" name="lidar_sensor">
      <pose>0 0 0 0 0 0</pose>
      <visualize>false</visualize> 
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>180</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.15</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
      </ray>
      <plugin name="gazebo_ros_lidar" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <remapping>~/out:=scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>lidar_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- ======================================================= -->
  <!-- SENSORS: IMU (Red axis points to Hub Wheels)            -->
  <!-- ======================================================= -->
  <link name="imu_link">
    <visual>
      <geometry>
        <box size="0.02 0.02 0.01"/>
      </geometry>
      <material name="black"/>
    </visual>
    <xacro:box_inertia m="0.05" w="0.02" h="0.02" d="0.01"/>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="chassis"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <gazebo reference="imu_link">
    <sensor type="imu" name="imu_sensor">
      <always_on>true</always_on>
      <update_rate>20</update_rate>
      <plugin name="gazebo_ros_imu" filename="libgazebo_ros_imu_sensor.so">
        <ros>
          <remapping>~/out:=imu/data</remapping>
        </ros>
        <initial_orientation_as_reference>false</initial_orientation_as_reference>
        <frame_name>imu_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- ======================================================= -->
  <!-- GAZEBO DIFFERENTIAL DRIVE PLUGIN                        -->
  <!-- ======================================================= -->
  <gazebo>
    <plugin name="front_diff_drive" filename="libgazebo_ros_diff_drive.so">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>${track_width}</wheel_separation>
      <wheel_diameter>${hub_radius * 2}</wheel_diameter>
      <max_wheel_torque>20</max_wheel_torque>
      <max_wheel_acceleration>2.0</max_wheel_acceleration>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>true</publish_wheel_tf>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
    </plugin>
  </gazebo>

</robot>